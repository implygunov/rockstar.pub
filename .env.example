# Скопируй этот файл в .env и заполни значения: cp .env.example .env

# === CryptoBot (оплата криптой) ===
# Токен из @CryptoBot → Crypto Pay → My Apps
CRYPTOBOT_TOKEN=
CRYPTOBOT_API=https://pay.crypt.bot/api

# === JWT ===
JWT_SECRET=

# === MySQL ===
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# === Сервер ===
PORT=8081
